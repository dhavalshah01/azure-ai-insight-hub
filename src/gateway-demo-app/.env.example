# ------------------------------------------------------------------
# APIM AI Gateway
# ------------------------------------------------------------------
APIM_GATEWAY_URL=https://apim-<environmentName>.azure-api.net
CHAT_MODEL=gpt-4o
OPENAI_API_VERSION=2024-10-21
PORT=8100

# ------------------------------------------------------------------
# Products (tiers)
# List the product IDs, then add DISPLAY_NAME and TPM for each one.
# Variable names use the ID in upper case, with "-" replaced by "_".
# TPM must match the token limit for that product in policies/ai-gateway-api.xml.
# ------------------------------------------------------------------
PRODUCTS=free,standard,premium

PRODUCT_FREE_DISPLAY_NAME=Free
PRODUCT_FREE_TPM=500

PRODUCT_STANDARD_DISPLAY_NAME=Standard
PRODUCT_STANDARD_TPM=5000

PRODUCT_PREMIUM_DISPLAY_NAME=Premium
PRODUCT_PREMIUM_TPM=200000

# ------------------------------------------------------------------
# Team subscriptions
# List the APIM subscription names, then add DISPLAY_NAME, PRODUCT and KEY for each one.
# PRODUCT must be one of the IDs in PRODUCTS and match the subscription's scope in APIM.
# KEY is the subscription's primary key. Never commit real keys.
# ------------------------------------------------------------------
SUBSCRIPTIONS=rate-limit-tester,member-services,digital-banking,lending-team

SUBSCRIPTION_RATE_LIMIT_TESTER_DISPLAY_NAME=Rate Limit Tester
SUBSCRIPTION_RATE_LIMIT_TESTER_PRODUCT=free
SUBSCRIPTION_RATE_LIMIT_TESTER_KEY=

SUBSCRIPTION_MEMBER_SERVICES_DISPLAY_NAME=Member Services
SUBSCRIPTION_MEMBER_SERVICES_PRODUCT=standard
SUBSCRIPTION_MEMBER_SERVICES_KEY=

SUBSCRIPTION_DIGITAL_BANKING_DISPLAY_NAME=Digital Banking
SUBSCRIPTION_DIGITAL_BANKING_PRODUCT=standard
SUBSCRIPTION_DIGITAL_BANKING_KEY=

SUBSCRIPTION_LENDING_TEAM_DISPLAY_NAME=Lending Team
SUBSCRIPTION_LENDING_TEAM_PRODUCT=premium
SUBSCRIPTION_LENDING_TEAM_KEY=
